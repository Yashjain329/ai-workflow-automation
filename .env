# Environment Configuration for AI Workflow Automation Platform
# Copy this to .env and modify as needed

# Server Settings
PROJECT_NAME="AI-Based Intelligent Workflow Automation Platform"
VERSION="1.0.0"
API_PREFIX="/api"
PORT=8000
HOST="0.0.0.0"

# Database Connection (SQLite local default / PostgreSQL production)
DATABASE_URL="sqlite:///./workflow_automation.db"

# Hybrid AI & Policy Confidence Thresholds
CONFIDENCE_HIGH=0.90    # Threshold for straight-through automated execution
CONFIDENCE_MEDIUM=0.70  # Threshold for Human Approval Queue escalation (below 0.70 = reject)

# Business Financial Rules
AUTO_APPROVE_MAX_AMOUNT=5000.0  # Max invoice dollar amount for auto-approval without policy escalation

# Resilience & Retries
MAX_RETRIES=3

# Additional Configurable Thresholds (from enhancement)
# Classifier thresholds
CLASSIFIER_UNKNOWN_CONFIDENCE=0.40
CLASSIFIER_INVOICE_KEYWORD_BONUS=3

# Extractor thresholds
EXTRACTOR_AMOUNT_CONFIDENCE_HIGH=0.95
EXTRACTOR_AMOUNT_CONFIDENCE_ZERO=0.0
EXTRACTOR_VENDOR_CONFIDENCE_HIGH=0.94
EXTRACTOR_VENDOR_CONFIDENCE_AMBIGUOUS=0.78
EXTRACTOR_VENDOR_CONFIDENCE_ZERO=0.0
EXTRACTOR_INVOICE_NUMBER_CONFIDENCE_HIGH=0.95
EXTRACTOR_INVOICE_NUMBER_CONFIDENCE_ZERO=0.0
EXTRACTOR_URGENCY_CONFIDENCE_HIGH=0.95
EXTRACTOR_URGENCY_CONFIDENCE_LOW=0.90
EXTRACTOR_URGENCY_CONFIDENCE_NORMAL=0.85
EXTRACTOR_DEPARTMENT_CONFIDENCE_KNOWN=0.92
EXTRACTOR_DEPARTMENT_CONFIDENCE_GENERAL=0.50

# Rules thresholds
RULES_VENDOR_CONFIDENCE_THRESHOLD=0.80
RULES_AMOUNT_CONFIDENCE_THRESHOLD=0.80
RULES_VENDOR_CONFIDENCE_AMBIGUITY_THRESHOLD=0.90
RULES_DEPARTMENT_CONFIDENCE_THRESHOLD=0.80

# API Keys for authentication (in production, use a secure secrets manager)
API_KEY_ADMIN="admin-secret-key-change-in-production"
API_KEY_OPERATOR="operator-secret-key-change-in-production"
API_KEY_VIEWER="viewer-secret-key-change-in-production"